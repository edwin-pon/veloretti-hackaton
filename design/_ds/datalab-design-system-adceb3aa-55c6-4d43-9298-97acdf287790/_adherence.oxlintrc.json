        "message": "<SearchBar> doesn't accept that prop. Declared props: value, onChange, onSubmit, placeholder, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SelectOption'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|label|key|ref|className|style|children)$/]",
        "message": "<SelectOption> doesn't accept that prop. Declared props: value, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='Skeleton'] > JSXAttribute > JSXIdentifier[name!=/^(?:width|height|circle|lines|style|key|ref|className|style|children)$/]",
        "message": "<Skeleton> doesn't accept that prop. Declared props: width, height, circle, lines, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='SliderInput'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|onChange|min|max|step|label|showValue|unit|key|ref|className|style|children)$/]",
        "message": "<SliderInput> doesn't accept that prop. Declared props: value, onChange, min, max, step, label, showValue, unit."
      },
      {
        "selector": "JSXOpeningElement[name.name='Spinner'] > JSXAttribute > JSXIdentifier[name!=/^(?:size|onDark|key|ref|className|style|children)$/]",
        "message": "<Spinner> doesn't accept that prop. Declared props: size, onDark."
