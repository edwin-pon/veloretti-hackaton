      {
        "selector": "JSXOpeningElement[name.name='Toast'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|message|variant|onClose|duration|inline|key|ref|className|style|children)$/]",
        "message": "<Toast> doesn't accept that prop. Declared props: open, message, variant, onClose, duration, inline."
