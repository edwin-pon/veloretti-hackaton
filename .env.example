# Point the front end at the n8n webhook that analyses an uploaded document.
# Leave unset to run the flow against the values baked into the prototype.
# The webhook receives multipart/form-data (brand, doc, fileName, document)
# when a real file is picked, or JSON metadata when the stand-in is used, and
# must respond with { "values": { "<fieldKey>": <value>, ... } }.
VITE_N8N_ANALYSE_URL=
