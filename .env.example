# Point the front end at the n8n webhook that analyses an uploaded document.
# Leave unset to run the flow against the values baked into the prototype.
# The webhook receives multipart/form-data (brand, doc, fileName, document)
# when a real file is picked, or JSON metadata when the stand-in is used, and
# must respond with { "values": { "<fieldKey>": <value>, ... } }.
VITE_N8N_ANALYSE_URL=

# Point the front end at the n8n webhook that receives a resolved campaign.
# The handoff screen POSTs { campaign, slots, summary, gates, exportedAt };
# `campaign` and `slots` match the JSON that screen downloads.
# A /webhook-test/ URL only accepts one call, and only after "Execute workflow"
# is clicked in n8n. Set the Webhook node's allowed origins if you want the
# browser to be able to read the reply.
VITE_N8N_CAMPAIGN_URL=
